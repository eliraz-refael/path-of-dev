{
  "name": "pathofdev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract": "PATHOFDEV_WRITE_CONTRACT=1 vitest run packages/server/test/contract.test.ts packages/server/test/snapshot-contract.test.ts packages/mod/test/contract.prop.ts",
    "site": "PATHOFDEV_WRITE_SITE=1 vitest run packages/engine/test/site-pages.test.ts"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@types/node": "^22.20.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "license": "MIT"
}
